{
	"semi": true,
	"singleQuote": true,
	"printWidth": 200,
	"tabWidth": 4,
	"useTabs": false,
	"trailingComma": "es5",
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"endOfLine": "auto",
	"vueIndentScriptAndStyle": true,
	"htmlWhitespaceSensitivity": "ignore",
	"singleAttributePerLine": false
}
